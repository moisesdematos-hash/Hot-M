# ==============================================================================
# HOT-M CANONICAL ENVIRONMENT CONFIGURATION (.env.example)
# RULE: NEVER COMMIT REAL SECRETS. NEVER EXPOSE SERVER-ONLY KEYS TO CLIENT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT ENVIRONMENT VARIABLES (VITE_ / NEXT_PUBLIC_)
# Only non-sensitive endpoints and public keys belong here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES
# CRITICAL: DO NOT PREFIX WITH NEXT_PUBLIC_. NEVER ACCESS FROM BROWSER CODE.
# ------------------------------------------------------------------------------
# Supabase Private Admin Access
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="super-secret-jwt-token"

# Database Direct Connection (PostgreSQL Pooling / Migrations)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# ProxyPay Gateway (Angola Multicaixa / Referência Bancária)
PROXYPAY_API_URL="https://api.sandbox.proxypay.co.ao" # Production: https://api.proxypay.co.ao
PROXYPAY_TOKEN="your_proxypay_api_token"
PROXYPAY_ENTITY="00000"
PROXYPAY_WEBHOOK_SECRET="your_proxypay_webhook_hmac_secret"

# Resend Transactional Email Gateway
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM_ADDRESS="HOT-M <no-reply@hot-m.com>"
EMAIL_SUPPORT_ADDRESS="support@hot-m.com"

# Groq AI Provider (Secondary - Knowledge & Creator Copilot Only)
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Security & Encryption Secrets
ENCRYPTION_KEY_32BYTES="0123456789abcdef0123456789abcdef" # AES-256-GCM key for sensitive token storage
WEBHOOK_SIGNING_SECRET="hmac_outbound_webhook_secret_key"

# Observability & Monitoring (Staging/Production)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
